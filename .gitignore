# Docker build cache
.docker/

# Jupyter checkpoints
notebooks/.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/

# macOS
.DS_Store

# Logs
*.log

# Generated artifacts (keep the directory, ignore content)
artifacts/*
!artifacts/.gitkeep

# Search studies and panel episode records (see web/panel_episodes.py)
runs/

# Review probes regenerate their raw output next to themselves; the .txt
# summaries are committed, the JSON is not.
docs/reviews/probes-*/*.json

# Local deployment configuration for docker compose, including any API key.
# Never committed: the key is a credential and the rest is machine-specific.
.env

# Willis's 3D-printer input files (STL/STEP/3DM, photo). Not committed: the repo
# is public and permission to publish these has not been given.
docs/input_3D_printer_files/

# Per-run randomised-colour scenes (scripts/make_part_colour_scene.py, #212).
scenes/generated/

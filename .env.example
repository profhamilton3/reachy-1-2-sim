# Copy to `.env` — which is gitignored — and edit.  `docker compose` reads
# `.env` automatically, so `docker compose up -d` then reproduces the intended
# deployment instead of the bare defaults.
#
# WHY THIS FILE EXISTS: the feature flags used to live only in the shell that
# happened to run scripts/start_sim.sh, so a later `docker compose up -d` —
# which is what you reach for after editing a scene — silently recreated the
# container with every default: the kinematic backend, the wrong scene, and the
# executor off.  The panel still came up and still looked connected.
#
# THIS file is committed; the `.env` you copy it to is not (see .gitignore).
# ANTHROPIC_API_KEY belongs only in that copy — it is the one secret here, and
# nothing else below is machine-specific enough to matter.

# --- simulator ------------------------------------------------------------
# MuJoCo physics, not the kinematic fixture: the physics backend is the
# training signal, and collisions are intentional feedback.
REACHY_SIM_BACKEND=mujoco-remote
REACHY_SIM_SCENE_FILE=/opt/scenes/FWDCenterLabSivaPool.yaml

# --- command panel --------------------------------------------------------
# Confirm actually moves the simulated arm.  The executor still refuses unless
# the simulator advertises the execution lease.
REACHY_PANEL_EXECUTOR=1

# An episode record for every ability the panel flies (#88).
REACHY_PANEL_EPISODES=1

# Promoted-recipe retrieval (#90).  Reads runs/promoted_recipes.db, which does
# not exist until a search has promoted something — so today this looks, finds
# nothing, and the ability flies the route it always flies.
REACHY_PANEL_RECIPES=1

# The optional language adapter (#92).  On here, and INERT until a key is
# present: without one it logs a warning at start-up and the panel uses the
# deterministic registry only, which is exactly what it did before the adapter
# existed.  Add the key below to switch it on for real.
REACHY_PANEL_LANGUAGE=1
# ANTHROPIC_API_KEY=
